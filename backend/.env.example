# ──────────────────────────────────────────────
# Cosmos Platform — Environment Configuration
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit the .env file to version control.

# ── Application ──────────────────────────────
APP_NAME=Cosmos Platform
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

# ── Server ───────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── PostgreSQL ───────────────────────────────
POSTGRES_USER=cosmos
POSTGRES_PASSWORD=changeme          # REQUIRED — no default in app
POSTGRES_DB=cosmos_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── CORS ─────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ── Logging ──────────────────────────────────
LOG_LEVEL=INFO

# ── JWT Authentication ───────────────────────
JWT_SECRET_KEY=super_secret_jwt_access_key_change_me_in_prod_123456789
JWT_REFRESH_SECRET_KEY=super_secret_jwt_refresh_key_change_me_in_prod_987654321
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

